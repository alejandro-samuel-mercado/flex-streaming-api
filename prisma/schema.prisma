// ─────────────────────────────────────────────────────────────────────────────
// PeliPlus — Schema Prisma (PROMPT MAESTRO)
// Stack: PostgreSQL + Prisma 5
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  GUEST
  REGISTERED
  MEMBER
  ADMIN
  SUPER_VENDOR
  VENDOR
  END_USER
}

enum ContentType {
  MOVIE
  SERIES
  ANIME
  ANIMATION
  DOCUMENTARY
  BIOGRAPHY
  REALITY_SHOW
  TALK_SHOW
  VARIETY_SHOW
  STAND_UP
  SPECIAL
  EDUCATIONAL
  KIDS
  FAMILY
  INTERACTIVE
  EXPERIMENTAL
  DOCUDRAMA
  NOVELA
  SHORT
}

enum ContentStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
  DRAFT
  PENDING
  ACTIVE
  INACTIVE
  UPCOMING
}

enum ProcessingStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ThumbnailType {
  POSTER
  BACKDROP
  PREVIEW
  LOGO
  STILL
}

enum VideoFileType {
  MOVIE
  TRAILER
  EPISODE
  CLIP
}

enum AdType {
  VIDEO
  IMAGE
}

enum AdPosition {
  PRE_ROLL
  MID_ROLL
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── USERS & AUTH ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  username      String?   @unique
  passwordHash  String?
  name          String?
  role          UserRole  @default(REGISTERED)
  isActive      Boolean   @default(true)
  googleId      String?   @unique
  appleId       String?   @unique
  preferredLang String?   @default("es")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Reseller system fields
  credits        Int       @default(0)
  parentId       String?
  parent         User?     @relation("UserHierarchy", fields: [parentId], references: [id])
  children       User[]    @relation("UserHierarchy")

  profiles      Profile[]
  refreshTokens RefreshToken[]
  memberships   UserMembership[]
  rentals       Rental[]
  contentRequests ContentRequest[]

  // Reseller system relations
  creditTransactions  CreditTransaction[]
  managedEndUsers     EndUserAccount[]  @relation("ManagedBy")
  endUserAccount      EndUserAccount?

  @@index([phone])
  @@map("users")
}

model Profile {
  id        String  @id @default(cuid())
  userId    String
  name      String
  avatar    String?
  isKids    Boolean @default(false)
  pin       String?
  language  String  @default("es")
  preferredTheme String?
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchHistory  WatchHistory[]
  favorites     Favorite[]
  myList        MyList[]
  reviews       Review[]
  watchSessions WatchSession[]
  comments      Comment[]

  @@index([userId])
  @@map("profiles")
}

model RefreshToken {
  id               String   @id @default(cuid())
  userId           String?
  endUserAccountId String?
  token            String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  endUserAccount  EndUserAccount? @relation(fields: [endUserAccountId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([endUserAccountId])
  @@map("refresh_tokens")
}

// ─── PLANS & MEMBERSHIPS ─────────────────────────────────────────────────────

model Plan {
  id            String  @id @default(cuid())
  name          String
  description   String?
  price         Decimal @db.Decimal(10, 2)
  durationDays  Int
  maxDevices    Int     @default(1)
  hasHd         Boolean @default(true)
  has4k         Boolean @default(false)
  allowDownload Boolean @default(false)
  noAds         Boolean @default(false)
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships UserMembership[]

  @@map("plans")
}

model UserMembership {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  startsAt  DateTime @default(now())
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("user_memberships")
}

// ─── PLATFORMS (MAGISTV STYLE) ────────────────────────────────────────────────

model Platform {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  isFeatured  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contents    Content[]

  @@map("platforms")
}

// ─── CONTENT (FILMS, SERIES, DOCUMENTARIES...) ───────────────────────────────

model Content {
  id          String        @id @default(cuid())
  type        ContentType
  status      ContentStatus @default(DRAFT)
  slug        String        @unique
  releaseYear Int?
  originalTitle String?
  title       String?
  duration    Int?
  rating      Float?
  reviewCount Int           @default(0)
  viewCount   BigInt        @default(0)
  downloadCount BigInt      @default(0)
  featured    Boolean       @default(false)
  country     String?
  languages   String[]
  originalLanguage String?
  budget      BigInt?
  revenue     BigInt?
  isAdult     Boolean       @default(false)
  isPinned    Boolean       @default(false)
  hasMissingFiles Boolean   @default(false)
  subtitleLangs String[]
  platformId  String?
  trailerUrl  String?
  rentalPrice Decimal?      @db.Decimal(10, 2)
  isFreeWithMembership Boolean @default(true)
  downloadAllowed Boolean  @default(false)
  tmdbId      String?       @unique
  imdbId      String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  translations    ContentTranslation[]
  videoFiles      VideoFile[]
  seasons         Season[]
  genres          ContentGenre[]
  tags            ContentTag[]
  thumbnails      Thumbnail[]
  reviews         Review[]
  watchHistory    WatchHistory[]
  favorites       Favorite[]
  likes           Like[]
  myList          MyList[]
  recommendations RecommendationItem[]
  actors          ContentActor[]
  directors       ContentDirector[]
  adTargets       AdTarget[]
  rentals         Rental[]
  comments        Comment[]
  contentRequests ContentRequest[]

  ageRatingId String?

  platform         Platform?               @relation(fields: [platformId], references: [id])
  ageRating        AgeRating?              @relation(fields: [ageRatingId], references: [id])

  @@index([type, status])
  @@index([slug])
  @@index([featured])
  @@index([status])
  @@map("contents")
}

model ContentTranslation {
  id        String @id @default(cuid())
  contentId String
  language  String
  title     String
  description String @db.Text
  tagline   String?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, language])
  @@index([contentId])
  @@map("content_translations")
}

// ─── VIDEO FILES & HLS PIPELINE ──────────────────────────────────────────────

model VideoFile {
  id              String           @id @default(cuid())
  contentId       String?
  episodeId       String?
  type            VideoFileType    @default(MOVIE)
  status          ProcessingStatus @default(PENDING)
  originalPath    String           @unique
  hlsPath         String?
  masterPlaylist  String?
  duration        Int?
  fileSize        BigInt?
  errorMessage    String?
  processingJobId String?
  // Identifica qué servidor procesó este video: 'MOVIES', 'SERIES' o 'ALL'
  sourceNode      String?          @default("ALL")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  content        Content?       @relation(fields: [contentId], references: [id])
  episode        Episode?       @relation(fields: [episodeId], references: [id])
  qualities      VideoQuality[]
  audioTracks    AudioTrack[]
  subtitleTracks SubtitleTrack[]

  @@index([contentId])
  @@index([episodeId])
  @@index([status])
  @@index([sourceNode])
  @@map("video_files")
}

model VideoQuality {
  id          String @id @default(cuid())
  videoFileId String
  resolution  String
  width       Int
  height      Int
  bitrate     Int
  playlistUrl String
  codec       String @default("h264")

  videoFile VideoFile @relation(fields: [videoFileId], references: [id], onDelete: Cascade)

  @@index([videoFileId])
  @@map("video_qualities")
}

model AudioTrack {
  id          String  @id @default(cuid())
  videoFileId String
  language    String
  label       String
  isDefault   Boolean @default(false)
  trackIndex  Int
  codec       String  @default("aac")

  videoFile VideoFile @relation(fields: [videoFileId], references: [id], onDelete: Cascade)

  @@index([videoFileId])
  @@map("audio_tracks")
}

model SubtitleTrack {
  id          String  @id @default(cuid())
  videoFileId String
  language    String
  label       String
  format      String  @default("vtt")
  url         String
  isDefault   Boolean @default(false)
  isForced    Boolean @default(false)

  videoFile VideoFile @relation(fields: [videoFileId], references: [id], onDelete: Cascade)

  @@index([videoFileId])
  @@map("subtitle_tracks")
}

// ─── SERIES, SEASONS, EPISODES ───────────────────────────────────────────────

model Season {
  id        String   @id @default(cuid())
  contentId String
  number    Int
  year      Int?
  posterUrl String?
  createdAt DateTime @default(now())

  content      Content              @relation(fields: [contentId], references: [id], onDelete: Cascade)
  translations SeasonTranslation[]
  episodes     Episode[]

  @@unique([contentId, number])
  @@map("seasons")
}

model SeasonTranslation {
  id          String  @id @default(cuid())
  seasonId    String
  language    String
  title       String
  description String? @db.Text

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, language])
  @@map("season_translations")
}

model Episode {
  id        String   @id @default(cuid())
  seasonId  String
  number    Int
  duration  Int?
  createdAt DateTime @default(now())

  season       Season               @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  translations EpisodeTranslation[]
  videoFiles   VideoFile[]
  thumbnails   Thumbnail[]
  watchHistory WatchHistory[]

  @@unique([seasonId, number])
  @@map("episodes")
}

model EpisodeTranslation {
  id          String  @id @default(cuid())
  episodeId   String
  language    String
  title       String
  description String? @db.Text

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, language])
  @@map("episode_translations")
}

// ─── CATEGORIES, GENRES, TAGS ────────────────────────────────────────────────

model Genre {
  id   String  @id @default(cuid())
  slug String  @unique
  name String  @unique
  icon String?

  contents ContentGenre[]

  @@map("genres")
}

model ContentGenre {
  contentId String
  genreId   String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([contentId, genreId])
  @@map("content_genres")
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  contents ContentTag[]

  @@map("tags")
}

model ContentTag {
  contentId String
  tagId     String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@map("content_tags")
}

model AgeRating {
  id       String @id @default(cuid())
  code     String @unique
  label    String
  contents Content[]

  @@map("age_ratings")
}

// ─── ACTORS & DIRECTORS ──────────────────────────────────────────────────────

model Actor {
  id          String    @id @default(cuid())
  name        String
  photoUrl    String?
  birthDate   DateTime?
  nationality String?
  biography   String?   @db.Text
  tmdbId      String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contents ContentActor[]

  @@index([name])
  @@map("actors")
}

model Director {
  id          String    @id @default(cuid())
  name        String
  photoUrl    String?
  birthDate   DateTime?
  nationality String?
  biography   String?   @db.Text
  tmdbId      String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contents ContentDirector[]

  @@index([name])
  @@map("directors")
}

model ContentActor {
  contentId String
  actorId   String
  character String?
  order     Int     @default(0)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actor   Actor   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([contentId, actorId])
  @@map("content_actors")
}

model ContentDirector {
  contentId  String
  directorId String

  content  Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  director Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@id([contentId, directorId])
  @@map("content_directors")
}

// ─── THUMBNAILS ──────────────────────────────────────────────────────────────

model Thumbnail {
  id        String        @id @default(cuid())
  contentId String?
  episodeId String?
  type      ThumbnailType
  url       String
  width     Int?
  height    Int?

  content Content? @relation(fields: [contentId], references: [id])
  episode Episode? @relation(fields: [episodeId], references: [id])

  @@unique([contentId, type])
  @@map("thumbnails")
}

// ─── USER ACTIVITY ───────────────────────────────────────────────────────────

model Like {
  id        String   @id @default(cuid())
  profileId String
  contentId String
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([profileId, contentId])
}

model WatchHistory {
  id        String   @id @default(cuid())
  profileId String
  contentId String?
  episodeId String?
  progress  Int      @default(0)
  duration  Int?
  completed Boolean  @default(false)
  watchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id])
  episode Episode? @relation(fields: [episodeId], references: [id])

  @@unique([profileId, contentId, episodeId])
  @@index([profileId])
  @@index([updatedAt])
  @@map("watch_history")
}

model WatchSession {
  id           String    @id @default(cuid())
  profileId    String
  videoFileId  String
  quality      String
  audioLang    String
  subtitleLang String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  ipAddress    String?
  userAgent    String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("watch_sessions")
}

model Favorite {
  profileId String
  contentId String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([profileId, contentId])
  @@map("favorites")
}

model MyList {
  profileId String
  contentId String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([profileId, contentId])
  @@map("my_list")
}

// ─── REVIEWS & COMMENTS ─────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  profileId String
  contentId String
  rating    Float?
  title     String?
  body      String?  @db.Text
  language  String   @default("es")
  likes     Int      @default(0)
  isHidden  Boolean  @default(false)
  status    CommentStatus @default(APPROVED)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  parent  Review? @relation("ReviewReplies", fields: [parentId], references: [id])
  replies Review[] @relation("ReviewReplies")

  @@unique([profileId, contentId, parentId])
  @@index([contentId])
  @@map("reviews")
}

model Comment {
  id        String        @id @default(cuid())
  contentId String
  profileId String
  parentId  String?
  body      String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  content Content  @relation(fields: [contentId], references: [id])
  profile Profile  @relation(fields: [profileId], references: [id])
  parent  Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([contentId])
  @@map("comments")
}

// ─── RECOMMENDATIONS ─────────────────────────────────────────────────────────

model RecommendationItem {
  id        String   @id @default(cuid())
  contentId String
  score     Float
  reason    String
  updatedAt DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id])

  @@map("recommendation_items")
}

// ─── RENTALS ─────────────────────────────────────────────────────────────────

model Rental {
  id         String   @id @default(cuid())
  userId     String
  contentId  String
  pricePaid  Decimal  @db.Decimal(10, 2)
  expiresAt  DateTime
  paymentRef String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  content Content @relation(fields: [contentId], references: [id])

  @@index([userId])
  @@index([contentId])
  @@map("rentals")
}

// ─── ADVERTISING ─────────────────────────────────────────────────────────────

model Ad {
  id           String     @id @default(cuid())
  name         String
  type         AdType
  fileUrl      String
  linkUrl      String?
  position     AdPosition
  midRollSec   Int?
  skipAfterSec Int        @default(5)
  isActive     Boolean    @default(true)
  targetAll    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  targets AdTarget[]

  @@map("ads")
}

model AdTarget {
  adId      String
  contentId String

  ad      Ad      @relation(fields: [adId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([adId, contentId])
  @@map("ad_targets")
}

// ─── SITE CONFIG ─────────────────────────────────────────────────────────────

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

// ─── UPLOADS ─────────────────────────────────────────────────────────────────

model Upload {
  id           String   @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    BigInt
  path         String
  uploadedBy   String?
  createdAt    DateTime @default(now())

  @@map("uploads")
}

// ─── RESELLER SYSTEM ─────────────────────────────────────────────────────────

enum CreditTransactionType {
  ADMIN_GRANT
  TRANSFER
  PLAN_ACTIVATION
  PACKAGE_PURCHASE
  REFUND
  ADJUSTMENT
}

enum EndUserAccountStatus {
  ACTIVE
  INACTIVE
  PAUSED
  DEMO
  EXPIRED
}

enum EndUserAccountType {
  DEMO
  FORMAL
}

enum DeviceType {
  WEB
  MOBILE
  SMART_TV
  UNKNOWN
}

model SubscriptionPlan {
  id            String      @id @default(cuid())
  name          String
  description   String?
  durationDays  Int
  creditCost    Int         @default(0)
  isDemo        Boolean     @default(false)
  demoHours     Int?
  isPromo       Boolean     @default(false)
  baseCredits   Int?
  bonusDays     Int?        @default(0)
  maxDevices    Int         @default(1)
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  endUserAccounts EndUserAccount[]
  planHistory     EndUserPlanHistory[]

  @@map("subscription_plans")
}

model CreditPackage {
  id              String    @id @default(cuid())
  name            String
  baseCredits     Int
  bonusCredits    Int       @default(0)
  isPromo         Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("credit_packages")
}

model CreditTransaction {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id])
  type            CreditTransactionType
  amount          Int
  balanceBefore   Int
  balanceAfter    Int
  description     String?
  relatedUserId   String?
  packageId       String?
  planId          String?
  createdById     String?

  createdAt       DateTime                @default(now())

  @@index([userId])
  @@map("credit_transactions")
}

model EndUserAccount {
  id                String                @id @default(cuid())
  username          String                @unique
  password          String
  passwordHash      String

  managedById       String
  managedBy         User                  @relation("ManagedBy", fields: [managedById], references: [id])

  userId            String?               @unique
  user              User?                 @relation(fields: [userId], references: [id])

  planId            String?
  plan              SubscriptionPlan?     @relation(fields: [planId], references: [id])

  status            EndUserAccountStatus  @default(INACTIVE)
  type              EndUserAccountType    @default(FORMAL)

  startDate         DateTime?
  endDate           DateTime?

  country           String?
  notes             String?
  maxDevices        Int                   @default(1)

  connectedDevices  DeviceSession[]
  planHistory       EndUserPlanHistory[]
  refreshTokens     RefreshToken[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  @@index([managedById])
  @@index([status])
  @@map("end_user_accounts")
}

model EndUserPlanHistory {
  id                String          @id @default(cuid())
  endUserAccountId  String
  endUserAccount    EndUserAccount  @relation(fields: [endUserAccountId], references: [id])
  planId            String
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  daysAdded         Int
  creditsCost       Int
  appliedById       String
  appliedAt         DateTime        @default(now())

  @@index([endUserAccountId])
  @@map("end_user_plan_history")
}

model DeviceSession {
  id                String          @id @default(cuid())
  endUserAccountId  String
  endUserAccount    EndUserAccount  @relation(fields: [endUserAccountId], references: [id])

  deviceToken       String          @unique
  deviceType        DeviceType      @default(UNKNOWN)
  deviceName        String?

  platform          String?
  osVersion         String?
  appVersion        String?
  browserName       String?

  ipAddress         String?
  refreshTokenId    String?
  lastSeen          DateTime        @default(now())
  isActive          Boolean         @default(true)

  createdAt         DateTime        @default(now())

  @@index([endUserAccountId])
  @@map("device_sessions")
}

// ─── IMPORT REJECTIONS LOG ───────────────────────────────────────────────────
// Registra contenido rechazado por el escáner porque el tipo TMDB no coincide
// con el tipo esperado por el servidor (ej: serie encontrada en servidor de películas)

model RejectedImport {
  id          String   @id @default(cuid())
  filePath    String
  fileName    String
  reason      String   // Ej: 'TMDB dice que es SERIE pero el servidor procesa PELÍCULAS'
  tmdbId      String?  // ID de TMDB si se pudo identificar
  tmdbTitle   String?  // Título según TMDB
  tmdbType    String?  // 'movie' | 'tv' según TMDB
  serverMode  String   // 'MOVIES' | 'SERIES' | 'ALL' — el modo del servidor que rechazó
  resolvedAt  DateTime? // Si el admin lo marcó como revisado
  createdAt   DateTime @default(now())

  @@index([serverMode])
  @@index([createdAt])
  @@map("rejected_imports")
}

// ─── CONTENT REQUESTS & REPORTS ──────────────────────────────────────────────

enum RequestType {
  REQUEST
  REPORT
}

enum RequestStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

model ContentRequest {
  id          String        @id @default(cuid())
  userId      String
  type        RequestType
  status      RequestStatus @default(PENDING)

  // TMDB info (For Requests)
  tmdbId      String?
  tmdbTitle   String?
  tmdbType    String?
  tmdbPoster  String?

  // Internal content info (For Reports)
  contentId   String?

  message     String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     Content?      @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
  @@index([userId])
  @@map("content_requests")
}
