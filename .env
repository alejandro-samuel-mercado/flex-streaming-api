NODE_ENV=development
BACKEND_PORT=4010

FRONTEND_URL=https://flex-streaming.vercel.app

BACKEND_URL=https://api-streamflex.unixxtech.online

# Base de datos (PostgreSQL en docker, puerto 5433)
DATABASE_URL="postgresql://peliplus:peliplus_secret@localhost:5433/peliplus?schema=public"



# Redis
REDIS_URL="redis://:redis_secret@localhost:6379"

# JWT
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=180d
JWT_REFRESH_EXPIRES_IN=180d

# Streaming — URLs firmadas
STREAM_SECRET=change_this_to_a_long_random_secret_for_signed_urls_64chars

# Almacenamiento de media (ajustar a la ruta de tu disco de 64TB)
MEDIA_PATH=/home/peliplus_gran_disco
UPLOADS_PATH=/home/peliplus_gran_disco/uploads
HLS_PATH=/home/peliplus_gran_disco/hls
THUMBNAILS_PATH=/home/peliplus_gran_disco/thumbnails
SUBTITLES_PATH=/home/peliplus_gran_disco/subtitles

# FFmpeg (si está en PATH, dejar como está)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_CONCURRENT_ENCODING=1

# OAuth Google
GOOGLE_CLIENT_ID=placeholder_client_id
GOOGLE_CLIENT_SECRET=placeholder_client_secret

# SMTP para emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=password
SMTP_FROM=no-reply@peliplus.com

# TMDB (Movie Database API)
TMDB_API_KEY=a3a77d587a5e7b6a2984949c890ce7e7
